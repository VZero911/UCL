// factorial.ucl — the same factorial two ways: recursion and an iterative loop.
fn fact(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    return n * fact(n - 1);
}

fn fact_iter(n: i64) -> i64 {
    let acc: i64 = 1;
    let i: i64 = 2;
    while i <= n {
        acc = acc * i;
        i = i + 1;
    }
    return acc;
}

fn main() -> i32 {
    let n: i64 = 1;
    while n <= 12 {
        print("fact", n, "=", fact(n), "iter", fact_iter(n));
        n = n + 1;
    }
    return 0;
}
