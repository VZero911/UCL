// counter.ucl — demonstrates class instantiation and method calls.

class Counter {
    count: i32;

    fn get() -> i32 {
        return count;
    }

    fn increment(n: i32) -> i32 {
        return count + n;
    }
}

fn main() -> i32 {
    let c: Counter = Counter();
    print("initial:", c.get());
    print("after +5:", c.increment(5));
    print("after +10:", c.increment(10));
    return 0;
}
