// fib.ucl — recursion + control flow, fully runnable in the v0 evaluator.
fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() -> i32 {
    let i: i64 = 0;
    while i <= 10 {
        print("fib", i, "=", fib(i));
        i = i + 1;
    }
    return 0;
}
