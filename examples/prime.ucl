// prime.ucl — trial-division primality test; prints the primes below 50.
fn is_prime(n: i64) -> bool {
    if n < 2 {
        return false;
    }
    let d: i64 = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 1;
    }
    return true;
}

fn main() -> i32 {
    let n: i64 = 2;
    let count: i64 = 0;
    while n < 50 {
        if is_prime(n) {
            print("prime", n);
            count = count + 1;
        }
        n = n + 1;
    }
    print("count", count);
    return 0;
}
